# Copy to infra/production/.env and replace every empty secret/config value.
# Never commit .env or use demonstration credentials on a deployed environment.
COMPOSE_PROJECT_NAME=wemove-production
RELEASE=
DOMAIN=
TLS_EMAIL=
DEPLOYMENT_ENV=production
IMAGE_PREFIX=wemove
POSTGRES_DB=wemove
POSTGRES_USER=wemove
POSTGRES_PASSWORD=
# URL-encode password characters. Host is the internal postgres service.
DATABASE_URL=
REDIS_PASSWORD=
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=2h
MEDIA_SIGNING_SECRET=
MEDIA_SCAN_TOKEN=
NOTIFICATION_ENCRYPTION_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
GLOBAL_RATE_LIMIT_PER_MIN=1200
# Enable provider mode in the market workbench only after configuring these.
PAYMENT_PROVIDER_URL=
PAYMENT_PROVIDER_KEY=
PAYMENT_WEBHOOK_SECRET=
B2B_PAYMENT_MODE=WEBHOOK
B2B_PAYMENT_CREATE_URL=
B2B_PAYMENT_WEBHOOK_SECRET=
B2B_SALES_EMAIL=
# Optional image overrides can pin the reviewed digest for an immutable release.
REDIS_IMAGE=redis:7-alpine
CADDY_IMAGE=caddy:2-alpine
CLAMAV_IMAGE=clamav/clamav:stable

# pgBackRest encrypts full/differential backups and continuous WAL archives.
# Keep this key off the database host as well; losing it makes recovery impossible.
PGBACKREST_CIPHER_PASS=
# Setting all S3 fields enables a second encrypted repository off this host.
PGBACKREST_S3_BUCKET=
PGBACKREST_S3_ENDPOINT=
PGBACKREST_S3_REGION=
PGBACKREST_S3_KEY=
PGBACKREST_S3_KEY_SECRET=

# Set 1,2 when the off-host S3 repository is enabled.
BACKUP_REPOSITORIES=1
