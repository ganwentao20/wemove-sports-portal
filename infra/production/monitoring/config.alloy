discovery.docker "wemove" {
  host = "unix:///var/run/docker.sock"
}
discovery.relabel "wemove" {
  targets = discovery.docker.wemove.targets
  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_project"]
    regex = sys.env("COMPOSE_PROJECT_NAME")
    action = "keep"
  }
  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label = "service"
  }
  rule {
    target_label = "project"
    replacement = sys.env("COMPOSE_PROJECT_NAME")
  }
}
loki.source.docker "wemove" {
  host = "unix:///var/run/docker.sock"
  targets = discovery.relabel.wemove.output
  forward_to = [loki.write.local.receiver]
}
loki.write "local" {
  endpoint { url = "http://loki:3100/loki/api/v1/push" }
}
