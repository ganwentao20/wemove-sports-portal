# 复制为同目录 infra/.env 后按需修改；所有值为本地开发默认值。
POSTGRES_USER=wemove
POSTGRES_PASSWORD=wemove_dev
POSTGRES_DB=wemove
POSTGRES_PORT=5432
REDIS_PORT=6379

# 供 apps/api/.env 使用的连接串（apps/api 默认按此默认值工作，无需复制也可启动）
DATABASE_URL=postgresql://wemove:wemove_dev@localhost:5432/wemove?schema=public
REDIS_URL=redis://localhost:6379/0
