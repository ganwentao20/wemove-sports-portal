# ============================================================
# WEMOVE SPORTS · 仓库级 .gitignore（单一来源，应用内不再重复）
# 约定：仅忽略“可再生成/本机私有/机密”文件；模板与示例一律入库。
# ============================================================

# ---------- 依赖 ----------
node_modules/
.pnp
.pnp.js
*.node

# ---------- 构建产物 ----------
dist/
build/
.next/
out/
.turbo/
*.tsbuildinfo
__pycache__/
*.py[cod]

# ---------- 测试与质量 ----------
coverage/
.nyc_output/
junit.xml
test-results/
playwright-report/

# ---------- 日志 ----------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---------- 环境变量：只允许 .env.example 入库 ----------
.env
.env.*
!.env.example
!**/.env.example
!.env.example.*

# ---------- 本地上传/媒体（运行时产生，不入库） ----------
uploads/
apps/api/uploads/
apps/web/public/uploads/

# ---------- 本地沙箱/工具缓存（Windows 重定向目录） ----------
.local/

# ---------- IDE / 编辑器 ----------
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ---------- 操作系统 ----------
.DS_Store
Thumbs.db
Desktop.ini

# ---------- Office 临时文件 / 个人草稿（如 ~$xxx.docx） ----------
~$*
*.tmp
*.bak

# ---------- 其他 ----------
*.pem
*.key
.dccache
