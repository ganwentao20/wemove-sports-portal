# 复制为同目录 apps/api/.env（.env 不入库），本地开发默认值如下即可跑通骨架。
# 也可直接复用根目录 infra/.env.example 的连接串（两者默认一致）。

NODE_ENV=development
PORT=8080

# PostgreSQL（infra/docker-compose.yml）
DATABASE_URL=postgresql://wemove:wemove_dev@localhost:5432/wemove?schema=public

# Redis（限流计数 + JWT 登出黑名单；未配置/不可达时 API 自动降级为不启用，见 README 安全说明）
REDIS_URL=redis://localhost:6379/0

# 全局限流（全局中间件）：单 IP 每分钟请求上限；默认 12000（兼容 100 并发压测），防刷场景调低
GLOBAL_RATE_LIMIT_PER_MIN=12000

# 邮件（SMTP）：不配置 SMTP_HOST = 开发日志模式（验证链接打到终端）；
# 联调邮箱闭环使用 Mailpit（npm run db:up 后 UI 为 http://localhost:8025）：
SMTP_HOST=
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
EMAIL_FROM=WEMOVE SPORTS <no-reply@wemovetoy.com>
APP_BASE_URL=http://localhost:3000

# JWT：本地开发可任意改；生产必须换强随机值（组长安全红线）
JWT_ACCESS_SECRET=dev_only_change_me_wemove_access
JWT_ACCESS_EXPIRES_IN=2h

# 注册后是否强制邮箱验证（true=必须验证后才能登录；配合 SMTP_HOST 或开发日志模式使用）
EMAIL_VERIFY_REQUIRED=false

# Seed 引导的管理员（仅本地/测试环境使用）
SEED_ADMIN_EMAIL=admin@wemove.local
SEED_ADMIN_PASSWORD=Admin@12345

# CORS 允许来源（逗号分隔；生产只允许显式 https:// 来源，禁止 *）
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
